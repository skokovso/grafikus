# =====================================================================
# Универсальный .gitignore для проекта "Сводный график"
# Правило: в репозиторий не попадают данные рантайма, кэши, секреты.
# Код, схемы, шаблоны и документация — попадают.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Данные рантайма и тестовые данные
#    Базы, загрузки, экспорты, персональные данные, большие файлы
#    (Справочники в корне репозитория остаются, так как это конфиги по умолчанию)
# ---------------------------------------------------------------------
data/
data/input/
data/output/
data/archive/
data/docs/

# ---------------------------------------------------------------------
# 2. Генерируемая документация и упаковка для ИИ
# ---------------------------------------------------------------------
project_info/ai_pack/
project_info/manuals/pdf/

# ---------------------------------------------------------------------
# 3. Временные файлы парсера (генерируются при обработке PDF)
# ---------------------------------------------------------------------
*_extracted.txt
*_extracted_tables.xlsx

# ---------------------------------------------------------------------
# 4. Кэши Python, временные файлы, сборки (PyInstaller)
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
# *.spec — ВАЖНО: Sonolog.spec должен быть в git, не игнорируем

# ---------------------------------------------------------------------
# 5. Секреты и локальные настройки
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
config.local.json
settings.local.ini

# ---------------------------------------------------------------------
# 6. Логи
# ---------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------
# 7. Мусор ОС и редакторов
# ---------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.directory
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------
# 8. Резервные копии и устаревшие файлы
# ---------------------------------------------------------------------
*_backup/
_backup/
*.bak
*.backup
grafikus.py.bak
* олд.docx
* исправлен.docx
diagnostic.py
